<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MVVMBBasic.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Views"
    xmlns:welcome="clr-namespace:MVVMBBasic.Views"
    Title="MVVMBBasic"
    FlyoutBehavior="Flyout">

    <FlyoutItem Title="Welcome" Icon="appicon.png">
        <ShellContent
            Title="Welcome"
            ContentTemplate="{DataTemplate welcome:WelcomePage}"
            Route="WelcomePage" />
    </FlyoutItem>

    <FlyoutItem Title="Calculator Age">
        <ShellContent
        Title="Calculator Age"
        Route="CalcAge"
        ContentTemplate="{DataTemplate views:CalcAgePage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Math Calculator">
        <ShellContent
        Title="Math Calculator"
        Route="CalculatorPage"
        ContentTemplate="{DataTemplate views:CalculatorPage}"/>
    </FlyoutItem>

    <FlyoutItem Title="Currency Converter">
        <ShellContent
        Title="Currency Converter"
        Route="CalcCurrency"
        ContentTemplate="{DataTemplate views:CalcCurrency}"/>
    </FlyoutItem>

</Shell>