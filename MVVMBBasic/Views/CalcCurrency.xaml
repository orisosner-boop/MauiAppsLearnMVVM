<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ViewModels"
             x:Class="Views.CalcCurrency"
             x:DataType="vm:CalcCurrencyViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="30" Spacing="18" VerticalOptions="Center">

        <Label Text="ממיר מטבע"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Entry Text="{Binding Amount}"
               Placeholder="הכנס סכום"
               Keyboard="Numeric" />

        <Label Text="ממטבע" FontSize="18" />
        <Picker ItemsSource="{Binding CurrencyOptions}"
                SelectedItem="{Binding FromCurrency}" />

        <Label Text="למטבע" FontSize="18" />
        <Picker ItemsSource="{Binding CurrencyOptions}"
                SelectedItem="{Binding ToCurrency}" />

        <Button Text="חשב" Command="{Binding CalculateCommand}" />

        <Border BackgroundColor="#F5F5F5" Padding="15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <Label Text="{Binding Result}"
                   FontSize="18"
                   HorizontalOptions="Center" />
        </Border>

    </VerticalStackLayout>
</ContentPage>